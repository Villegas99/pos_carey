<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Regla GLOBAL (sin "groups"): se aplica a TODOS los usuarios y se
         combina con AND contra cualquier otra regla de cualquier módulo,
         incluidas las reglas nativas de point_of_sale. Esto es lo que
         garantiza que ninguna regla permisiva de otro grupo (por ejemplo
         la de cajero de POS) pueda anular esta restricción. -->
    <record id="rule_partner_branch_isolation" model="ir.rule">
        <field name="name">Clientes: aislamiento por sucursal (regla global)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">(
            [(1, '=', 1)]
            if (user.has_group('pos_carey.group_pos_branch_manager')
                or user.has_group('base.group_system')
                or not user.has_group('pos_carey.group_pos_branch_operator'))
            else ['|', ('pos_branch_id', '=', False), ('pos_branch_id', '=', user.pos_operator_branch_id.id)]
        )</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>